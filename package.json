{
  "name": "NeteaseCloudMusicApi",
  "version": "4.8.11",
  "description": "网易云音乐 NodeJS 版 API",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:cluster": "tsx src/cluster.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "regression": "node scripts/api-regression.cjs --base http://localhost:3000 --tier P0,P1",
    "regression:compare": "node scripts/api-regression.cjs --base http://localhost:3000 --tier P0,P1 --compare docs/regression-baseline.json --out docs/regression-latest.json --md docs/regression-report.md",
    "plan": "node scripts/gen-api-test-plan.cjs",
    "verify:identity": "tsx scripts/verify-qr-identity.ts",
    "config:anon": "tsx scripts/generate-config.ts",
    "test": "mocha \"test/**/*.test.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.{cjs,ts}\"",
    "lint-fix": "npm run lint -- --fix",
    "prepare": "husky install",
    "verify:contracts": "node scripts/verify-contracts.cjs --out docs/contract-report.md",
    "regression:authed": "node scripts/api-regression.cjs --base http://localhost:3000 --tier P0,P1,P2 --out docs/regression-authed.json"
  },
  "bin": "./dist/main.js",
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "node_modules/axios",
      "node_modules/fastify",
      "node_modules/@fastify",
      "node_modules/md5",
      "node_modules/music-metadata",
      "node_modules/pac-proxy-agent",
      "node_modules/qrcode",
      "node_modules/safe-decode-uri-component",
      "node_modules/tunnel",
      "node_modules/yargs",
      "node_modules/tslib",
      "node_modules/vm2",
      "public"
    ]
  },
  "keywords": [
    "网易云音乐",
    "网易云",
    "音乐",
    "网易云音乐nodejs"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "git add"
    ]
  },
  "author": "binaryify",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "docs",
    "scripts",
    "static",
    "interface.d.ts"
  ],
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@unblockneteasemusic/server": "^0.28.0",
    "axios": "^1.2.2",
    "fastify": "^5.12.5",
    "md5": "^2.3.0",
    "music-metadata": "^7.5.3",
    "pac-proxy-agent": "^5.0.0",
    "qrcode": "^1.4.4",
    "safe-decode-uri-component": "^1.2.1",
    "tunnel": "^0.0.6",
    "yargs": "^17.1.1"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "5.0.0",
    "@typescript-eslint/parser": "5.0.0",
    "eslint": "8.7.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-html": "7.1.0",
    "eslint-plugin-prettier": "4.0.0",
    "husky": "7.0.4",
    "intelli-espower-loader": "1.1.0",
    "lint-staged": "12.1.7",
    "mocha": "10.0.0",
    "pkg": "^5.8.0",
    "power-assert": "1.6.1",
    "prettier": "2.7.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
